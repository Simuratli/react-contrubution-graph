{
  "name": "@your-npm-username/react-contribution-graph",
  "private": false,
  "version": "0.1.0",
  "description": "GitHub style contribution grid component",
  "keywords": [
    "react",
    "github",
    "contribution",
    "contribution-graph",
    "heatmap",
    "calendar",
    "activity"
  ],
  "license": "MIT",
  "author": "Eljan Simuratli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simuratli/react-contrubution-graph"
  },
  "homepage": "https://github.com/Simuratli/react-contrubution-graph#readme",
  "bugs": {
    "url": "https://github.com/Simuratli/react-contrubution-graph/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
